{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The contact form's backend. The site reaches it through its service binding only: no public
  // address, no previews.
  "name": "cyberspark-www-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  // Enquiries. 
  "d1_databases": [{"binding":"DB","database_name":"cyberspark-www-enquiries","database_id":"f44c1bde-ad04-414c-8061-ae301725ccad","migrations_dir":"migrations"}],
  "vars": {
    "SITE_NAME": "CyberSpark",
    "SITE_ID": "cyberspark",
    // Where enquiries are emailed: keep it the same as forms.inbox in sites/main/site.config.ts.
    "FORM_INBOX": "hananfdar+beta2@gmail.com",
    "GATEWAY_URL": "https://gateway.craeft.org"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, FORMS_KEY.
}
